# Build products and machine state — never committed.
# The APK is a build output, not source: `node lab/build/build-apk.mjs` recreates it.
artifacts/
out/
work/

# Oracle interpreter. pyelftools is an independent CHECK, not a dependency of the analyser.
.venv/

# Generated by aapt2 from lab/build/build-apk.mjs; the real Android framework table
# belongs to the SDK, and this stub is regenerated on every build.
lab/build/framework-res/

# Never commit a sample binary, a keystore, or a private key.
*.apk
*.so
*.dex
*.keystore
*.jks
