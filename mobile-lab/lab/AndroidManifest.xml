<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-authored sample manifest for the mobile-lab static analysis lane.

  Deliberately contains the component shapes the extractor must handle:
    - an exported activity with an intent-filter (com.lab.mobilelab.MainActivity)
    - a non-exported service            (com.lab.mobilelab.SessionService)
    - a content provider with authorities (com.lab.mobilelab.data)
    - a broadcast receiver
    - a permission declaration
    - networkSecurityConfig pointing at the pin-set resource
    - android:debuggable="true", so the sample is inspectable rather than hardened
  Nothing here targets a third-party app; it is our own fixture.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lab.mobilelab"
    android:versionCode="1"
    android:versionName="1.0.0-lab">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:debuggable="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hasCode="true">

        <activity
            android:name="com.lab.mobilelab.MainActivity"
            android:exported="true"
            android:label="@string/title_main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.lab.mobilelab.DebugActivity"
            android:exported="false" />

        <service
            android:name="com.lab.mobilelab.SessionService"
            android:exported="false" />

        <provider
            android:name="com.lab.mobilelab.SessionProvider"
            android:authorities="com.lab.mobilelab.data"
            android:exported="false" />

        <receiver
            android:name="com.lab.mobilelab.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
