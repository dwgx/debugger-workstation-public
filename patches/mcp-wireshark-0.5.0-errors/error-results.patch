+"""Regression tests for failure status across decode and low-level SDK routing."""
+from pathlib import Path
+from unittest.mock import AsyncMock, patch
+
+import pytest
+from mcp.types import CallToolRequest, CallToolRequestParams, CallToolResult, TextContent
+
+from mcp_wireshark import server
+from mcp_wireshark.read_tools import handle_decode_protocol
+from mcp_wireshark.utils import WiresharkNotFoundError
+
+
+async def routed(arguments: dict[str, object], name: str = "decode_protocol") -> CallToolResult:
+    request = CallToolRequest(
+        method="tools/call", params=CallToolRequestParams(name=name, arguments=arguments)
+    )
+    with patch("mcp_wireshark.server.check_wireshark_installed", return_value={"tshark": "fixture"}):
+        response = await server.app.request_handlers[CallToolRequest](request)
+    assert isinstance(response.root, CallToolResult)
+    return response.root
+
+
+@pytest.mark.asyncio
+async def test_error_result_positive_list_preserved(tmp_path: Path) -> None:
+    pcap = tmp_path / "fixture.pcap"
+    pcap.touch()
+    table = "frame.number\tdns.qry.name\n1\tError.example\n"
+    args = {"file_path": str(pcap), "protocol": "dns"}
+    with patch("mcp_wireshark.read_tools.run_tshark", AsyncMock(return_value=table)):
+        direct = await handle_decode_protocol(args)
+        wire = await routed(args)
+    assert isinstance(direct, list)
+    assert isinstance(direct[0], TextContent)
+    assert wire.isError is False
+    assert wire.content == direct
+    assert "Error.example" in wire.content[0].text
+
+
+@pytest.mark.asyncio
+async def test_error_result_decode_malformed(tmp_path: Path) -> None:
+    pcap = tmp_path / "bad.pcap"
+    pcap.write_bytes(b"not a capture")
+    args = {"file_path": str(pcap), "protocol": "dns"}
+    with patch("mcp_wireshark.read_tools.run_tshark", AsyncMock(side_effect=RuntimeError("bad capture"))):
+        response = await routed(args)
+    assert response.isError is True
+    assert response.content[0].text == "Error decoding protocol: bad capture"
+
+
+@pytest.mark.asyncio
+async def test_error_result_outer_runtime_error(tmp_path: Path) -> None:
+    pcap = tmp_path / "fixture.pcap"
+    pcap.touch()
+    with patch.dict(server.READ_HANDLERS, {"decode_protocol": AsyncMock(side_effect=RuntimeError("outer injected"))}):
+        response = await routed({"file_path": str(pcap), "protocol": "dns"})
+    assert response.isError is True
+    assert response.content[0].text == "Error: outer injected"
+
+
+@pytest.mark.asyncio
+async def test_error_result_outer_wireshark_missing(tmp_path: Path) -> None:
+    pcap = tmp_path / "fixture.pcap"
+    pcap.touch()
+    with patch.dict(server.READ_HANDLERS, {"decode_protocol": AsyncMock(side_effect=WiresharkNotFoundError("missing injected"))}):
+        response = await routed({"file_path": str(pcap), "protocol": "dns"})
+    assert response.isError is True
+    assert response.content[0].text == "Error: missing injected"
+
+
+@pytest.mark.asyncio
+async def test_error_result_tshark_missing_and_unknown_tool() -> None:
+    with patch("mcp_wireshark.server.check_wireshark_installed", return_value={"tshark": None}):
+        response = await server.call_tool("decode_protocol", {})
+    assert isinstance(response, CallToolResult)
+    assert response.isError is True
+    response = await routed({}, name="controlled_unknown_tool")
+    assert response.isError is True
+    assert response.content[0].text == "Unknown tool: controlled_unknown_tool"
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("changes", [
+    {"protocol": ""}, {"fields": []}, {"fields": "wrong type"},
+    {"fields": [""]}, {"file_path": "missing-owned.pcap"},
+])
+async def test_error_result_decode_validation(tmp_path: Path, changes: dict[str, object]) -> None:
+    pcap = tmp_path / "fixture.pcap"
+    pcap.touch()
+    args = {"file_path": str(pcap), "protocol": "dns", **changes}
+    response = await handle_decode_protocol(args)
+    assert isinstance(response, CallToolResult)
+    assert response.isError is True
+    assert response.content[0].text.startswith("Error:")
