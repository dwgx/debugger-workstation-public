+# ---------------------------------------------------------------------------
+# Confirmed 0.5.0 defects — semantic failures carried isError=False on the wire.
+# The three confirmed failures run directly and through the low-level MCP
+# CallToolRequest handler. Additional cases cover the other explicit branches.
+# Backend subprocess calls are mocked; this is not a stdio/wrapper test.
+# ---------------------------------------------------------------------------
+
+
+def _pcap(tmp_path: Path) -> Path:
+    pcap = tmp_path / "fixture.pcap"
+    pcap.touch()
+    return pcap
+
+
+def _fake_packets(n: int) -> str:
+    return json.dumps(
+        [
+            {"_index": "p", "_source": {"layers": {"frame": {"frame.number": str(i)}}}}
+            for i in range(1, n + 1)
+        ]
+    )
+
+
+@pytest.mark.asyncio
+async def test_read_pcap_corrupt_capture_is_error(tmp_path: Path) -> None:
+    """Regression: tshark failing on a corrupt capture must be isError=True."""
+    pcap = tmp_path / "corrupt.pcap"
+    pcap.write_bytes(b"not a real capture")
+    args = {"file_path": str(pcap)}
+    err = RuntimeError("tshark failed: The file appears to be broken")
+    with patch("mcp_wireshark.read_tools.run_tshark", AsyncMock(side_effect=err)):
+        direct = await handle_read_pcap(args)
+        wire = await routed(args, name="read_pcap")
+    assert isinstance(direct, CallToolResult)
+    assert direct.isError is True
+    assert direct.content[0].text == f"Error reading pcap file: {err}"
+    assert wire.isError is True
+    assert wire.content == direct.content
+
+
+@pytest.mark.asyncio
+async def test_read_pcap_unparsable_output_is_error(tmp_path: Path) -> None:
+    pcap = _pcap(tmp_path)
+    args = {"file_path": str(pcap)}
+    with patch(
+        "mcp_wireshark.read_tools.run_tshark",
+        AsyncMock(return_value="<html>tshark never emits this</html>"),
+    ):
+        direct = await handle_read_pcap(args)
+        wire = await routed(args, name="read_pcap")
+    assert isinstance(direct, CallToolResult)
+    assert direct.isError is True
+    assert direct.content[0].text.startswith("Error parsing packet data:")
+    assert wire.isError is True
+
+
